<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>hu.laci.learning</groupId>
    <artifactId>14-test-organization-and-config</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <!-- Java 17-re fordítunk és futtatunk. -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
        <selenium.version>4.27.0</selenium.version>
        <restassured.version>5.5.0</restassured.version>
        <jackson.version>2.18.2</jackson.version>
        <wiremock.version>3.10.0</wiremock.version>
        <!-- Futtatási beállítások, parancssorból felülírhatók: mvn test -Dheadless=true -Dwait.seconds=10 -->
        <headless>false</headless>
        <wait.seconds>5</wait.seconds>
    </properties>

    <dependencies>
        <!-- JUnit Jupiter: a teszt API és a tesztmotor. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Selenium: böngészőautomatizálás. -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Maven Compiler Plugin: a forráskódot Java 17-re fordítja. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <!-- Surefire: a test fázisban megkeresi és lefuttatja a JUnit 5 teszteket. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <failIfNoTests>true</failIfNoTests>
                    <systemPropertyVariables>
                        <headless>${headless}</headless>
                        <wait.seconds>${wait.seconds}</wait.seconds>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Profil: mvn test -Pheadless. A profil a headless tulajdonságot true-ra állítja. -->
        <profile>
            <id>headless</id>
            <properties>
                <headless>true</headless>
            </properties>
        </profile>
    </profiles>
</project>

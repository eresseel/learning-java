<?xml version="1.0" encoding="UTF-8"?>
<!--
  03. lépés – a webshop domain REST API-n keresztül (Spring Boot).
  A JUnit, Mockito, AssertJ stb. verzióját mostantól a Spring Boot BOM adja (nem írjuk felül).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- A Spring Boot szülő-POM: függőségverziók, plugin-alapbeállítások (surefire, failsafe, compiler). -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>hu.learning.webshop</groupId>
    <artifactId>03-spring-boot-rest-api</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>03 - Webshop REST API (Spring Boot)</name>

    <properties>
        <!-- A Boot parent ebből állítja a maven.compiler.release-t. -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Webes réteg: beágyazott Tomcat, Spring MVC, Jackson (JSON). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Bean Validation (@NotBlank, @NotNull) a kérés-DTO-khoz. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Teszt: JUnit Jupiter, Spring Test (MockMvc), AssertJ, Hamcrest, Mockito, JSONPath. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Futtatható ("fat") jar készítése és "mvn spring-boot:run". -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>

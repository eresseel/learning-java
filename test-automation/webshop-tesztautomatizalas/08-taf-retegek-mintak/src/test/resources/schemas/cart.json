{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Kosár",
  "description": "GET /cart, POST /cart/items, PATCH /cart/items/{id} válasza.",
  "type": "object",
  "required": ["items", "itemCount", "total", "currency"],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["productId", "name", "unitPrice", "quantity", "lineTotal"],
        "additionalProperties": false,
        "properties": {
          "productId": { "type": "string" },
          "name": { "type": "string" },
          "unitPrice": { "type": "number", "minimum": 0, "exclusiveMinimum": true },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 99 },
          "lineTotal": { "type": "number", "minimum": 0 }
        }
      }
    },
    "itemCount": { "type": "integer", "minimum": 0 },
    "total": { "type": "number", "minimum": 0 },
    "currency": { "type": "string", "enum": ["HUF"] }
  }
}

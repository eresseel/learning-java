<?xml version="1.0" encoding="UTF-8"?>
<!--
  10. lépés – CI/CD pipeline: a build-szakasz tesztjei (Surefire, *Test) és a telepítés utáni
  rendszertesztek (Failsafe, *IT) szétválasztva, Maven profilokkal (build-gate, deploy-gate).

  Futtatási módok:
    mvn verify                  teljes helyi ellenőrzés: unit/komponens tesztek, majd a csomagolt
                                alkalmazás elindítása véletlen porton és az *IT rendszertesztek ellene
    mvn verify -Pbuild-gate     csak a build-szakasz tesztjei (CI 1. kapu)
    mvn verify -Pdeploy-gate    csak az *IT rendszertesztek egy már telepített SUT ellen,
                                címe: WEBSHOP_BASE_URL környezeti változó (CI 2. kapu)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- A Spring Boot szülő-POM: függőségverziók, plugin-alapbeállítások (surefire, failsafe, compiler). -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>hu.learning.webshop</groupId>
    <artifactId>10-ci-pipeline</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>10 - CI pipeline: build és telepítési minőségkapuk</name>

    <properties>
        <!-- A Boot parent ebből állítja a maven.compiler.release-t. -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- A WireMock-ot a Spring Boot BOM nem kezeli, ezért a verziót mi adjuk meg. -->
        <wiremock.version>3.13.2</wiremock.version>

        <!-- Kapcsolók a profilokhoz (alapértelmezés: minden fut). -->
        <!-- Surefire (build-szakasz) tesztek kihagyása. -->
        <skipUnitTests>false</skipUnitTests>
        <!-- Failsafe (*IT) tesztek kihagyása – a Failsafe saját, beépített kapcsolója. -->
        <skipITs>false</skipITs>
        <!-- A helyi SUT elindításának kihagyása (deploy-gate-nél a SUT már telepítve van). -->
        <skipLocalSut>false</skipLocalSut>
        <!-- Az *IT tesztek célpontja; alapból a helyben indított alkalmazás (sut.port: build-helper foglalja). -->
        <webshop.baseUrl>http://localhost:${sut.port}</webshop.baseUrl>
    </properties>

    <dependencies>
        <!-- Webes réteg: beágyazott Tomcat, Spring MVC, Jackson (JSON). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Actuator: /actuator/health végpont – a tesztek előzetes ellenőrzése (preflight) ezt hívja. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Bean Validation (@NotBlank, @NotNull) a kérés-DTO-khoz. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Teszt: JUnit Jupiter, Spring Test (MockMvc), AssertJ, Hamcrest, Mockito, JSONPath. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- JUnit Platform TestKit: tesztek programozott futtatása – a saját JUnit extension tesztjéhez. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-testkit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- REST Assured: Java DSL HTTP API-k teszteléséhez (given / when / then). -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- JSON Schema (draft-04) validáció REST Assured matcherként: matchesJsonSchemaInClasspath(...). -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>json-schema-validator</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- WireMock (standalone = árnyékolt függőségekkel, nem ütközik a Spring Jetty/Jackson verzióival):
             HTTP mock szerver a külső PayPal API szimulálására. -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 1. Szabad portok foglalása a helyi SUT-nak és a JMX vezérlésnek (nincs portütközés a CI runneren). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>reserve-sut-ports</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>reserve-network-port</goal>
                        </goals>
                        <configuration>
                            <portNames>
                                <portName>sut.port</portName>
                                <portName>sut.jmx.port</portName>
                            </portNames>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 2. Build-szakasz: Surefire futtatja a *Test osztályokat ("test" fázis). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skipTests>${skipUnitTests}</skipTests>
                </configuration>
            </plugin>

            <!-- 3. Futtatható jar; az integration-test fázis előtt elindítja, utána leállítja az alkalmazást
                    (a "telepítés" helyi szimulációja). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>start-sut</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>start</goal>
                        </goals>
                        <configuration>
                            <skip>${skipLocalSut}</skip>
                            <jmxPort>${sut.jmx.port}</jmxPort>
                            <arguments>
                                <argument>--server.port=${sut.port}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stop-sut</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>stop</goal>
                        </goals>
                        <configuration>
                            <skip>${skipLocalSut}</skip>
                            <jmxPort>${sut.jmx.port}</jmxPort>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 4. Telepítés utáni szakasz: Failsafe futtatja a *IT osztályokat a futó SUT ellen.
                    Bukás esetén is lefut a post-integration-test (SUT leállítás), és csak a "verify"
                    fázis buktatja el a buildet. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <systemPropertyVariables>
                        <webshop.baseUrl>${webshop.baseUrl}</webshop.baseUrl>
                        <webshop.resultsFile>${project.build.directory}/taf-results-it.csv</webshop.resultsFile>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- CI 1. kapu (build): csak a build-szakasz tesztjei – komponens, komponensintegráció,
             szerződés, WireMock, TAF önteszt. Telepítés csak ennek sikere után. -->
        <profile>
            <id>build-gate</id>
            <properties>
                <skipITs>true</skipITs>
                <skipLocalSut>true</skipLocalSut>
            </properties>
        </profile>
        <!-- CI 2. kapu (telepítés után): csak a rendszertesztek a már telepített SUT ellen.
             A SUT címe a WEBSHOP_BASE_URL környezeti változóból jön. -->
        <profile>
            <id>deploy-gate</id>
            <properties>
                <skipUnitTests>true</skipUnitTests>
                <skipLocalSut>true</skipLocalSut>
                <webshop.baseUrl>${env.WEBSHOP_BASE_URL}</webshop.baseUrl>
            </properties>
        </profile>
    </profiles>
</project>

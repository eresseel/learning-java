<?xml version="1.0" encoding="UTF-8"?>
<!--
  PROJECT 01: Task API - alap Spring Boot CRUD alkalmazás
  Ez a modul tartalmazza a domain modellt, a repository-t, a service-t és a REST controllert.
  Sem adatbázis-konfiguráció, sem tesztek itt – csak a production kód.
  A tesztelés a 02-es és 03-as modulban történik.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- Spring Boot 3.4.x – legfrissebb stabil, Java 21 LTS kompatibilis -->
    <version>3.4.1</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>task-api</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>01 - Task API</name>
  <description>Alap Spring Boot CRUD API – Task entitás kezelése</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <!-- Web MVC réteg – REST controllerekhez -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- JPA – entitás perzisztencia, repositoryk -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Bean Validation – @NotBlank, @Size stb. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- PostgreSQL JDBC driver – runtime csak, nem kell compile-time -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
